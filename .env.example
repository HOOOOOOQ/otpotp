# Supabase — public values (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — SERVER ONLY. Bypasses RLS; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# JasaOTP — SERVER ONLY. Never expose this key to the browser or commit it.
JASAOTP_API_KEY=

# Optional: comma-separated admin emails. A user must ALSO have profiles.role = 'admin'.
ADMIN_EMAILS=

# Optional: canonical app URL used for auth redirects and same-origin checks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Cron sends: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Optional: manual deposit instructions shown to users (do not invent bank details).
NEXT_PUBLIC_DEPOSIT_INSTRUCTIONS=
